```css
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --primary: #2563eb;
  --primary-dark: #1d4ed8;
  --sidebar: #0f172a;
  --sidebar-light: #1e293b;
  --background: #f1f5f9;
  --card: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --border: #e2e8f0;
  --success: #16a34a;
}

body {
  font-family:
    Inter, Arial, Helvetica, sans-serif;
  background: var(--background);
  color: var(--text);
}

/* =========================
   LOGIN PAGE
========================= */

.login-page {
  min-height: 100vh;
  display: flex;
  background: #ffffff;
}

/* LEFT IMAGE */

.login-image {
  width: 55%;
  min-height: 100vh;

  background-image:
    linear-gradient(
      rgba(8, 24, 48, 0.58),
      rgba(8, 24, 48, 0.78)
    ),
    url("https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=1800&q=90");

  background-size: cover;
  background-position: center;

  display: flex;
  align-items: center;
  justify-content: center;

  position: relative;
}

.login-image::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      circle at 20% 20%,
      rgba(37, 99, 235, 0.45),
      transparent 35%
    );
}

.image-overlay {
  position: relative;
  z-index: 2;
  color: white;
  text-align: center;
  padding: 40px;
  max-width: 650px;
}

.company-logo-large {
  width: 95px;
  height: 95px;
  margin: 0 auto 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 24px;

  background: rgba(37, 99, 235, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.3);

  font-size: 32px;
  font-weight: 800;

  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.25);
}

.image-overlay h1 {
  font-size: 48px;
  line-height: 1.1;
  margin-bottom: 18px;
  letter-spacing: 1px;
}

.image-overlay p {
  font-size: 19px;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.9);
}

/* RIGHT LOGIN */

.login-form-section {
  width: 45%;
  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 50px;
  background: #ffffff;
}

.login-box {
  width: 100%;
  max-width: 430px;
}

.company-logo {
  width: 68px;
  height: 68px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: linear-gradient(
    135deg,
    #2563eb,
    #1d4ed8
  );

  color: white;

  border-radius: 18px;

  font-size: 24px;
  font-weight: 800;

  margin-bottom: 28px;

  box-shadow:
    0 12px 30px rgba(37, 99, 235, 0.25);
}

.login-box h2 {
  font-size: 32px;
  color: #0f172a;
  margin-bottom: 8px;
}

.login-subtitle {
  color: #64748b;
  margin-bottom: 32px;
  font-size: 15px;
}

.login-box form {
  display: flex;
  flex-direction: column;
}

.login-box label {
  font-size: 14px;
  font-weight: 600;
  color: #334155;
  margin-bottom: 8px;
}

.login-box input {
  width: 100%;
  padding: 14px 16px;

  border: 1px solid #cbd5e1;
  border-radius: 9px;

  margin-bottom: 20px;

  font-size: 15px;
  color: #0f172a;

  outline: none;

  transition: 0.2s;
}

.login-box input:focus {
  border-color: #2563eb;

  box-shadow:
    0 0 0 4px rgba(37, 99, 235, 0.1);
}

.login-button {
  width: 100%;

  border: none;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #1d4ed8
    );

  color: white;

  padding: 15px;

  border-radius: 9px;

  font-size: 16px;
  font-weight: 700;

  cursor: pointer;

  margin-top: 5px;

  transition: 0.2s;

  box-shadow:
    0 10px 25px rgba(37, 99, 235, 0.25);
}

.login-button:hover {
  transform: translateY(-1px);

  box-shadow:
    0 14px 30px rgba(37, 99, 235, 0.3);
}

.demo-login {
  margin-top: 22px;

  padding: 12px;

  background: #eff6ff;

  border-radius: 8px;

  color: #2563eb;

  font-size: 13px;

  text-align: center;
}

/* =========================
   APPLICATION LAYOUT
========================= */

.app-layout {
  min-height: 100vh;
  display: flex;
  background: #f1f5f9;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
  width: 260px;
  min-height: 100vh;

  background:
    linear-gradient(
      180deg,
      #0f172a 0%,
      #111827 100%
    );

  color: white;

  padding: 24px 16px;

  display: flex;
  flex-direction: column;

  position: sticky;
  top: 0;
  left: 0;
}

.sidebar-logo {
  width: 52px;
  height: 52px;

  display: flex;
  align-items: center;
  justify-content: center;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #1d4ed8
    );

  border-radius: 14px;

  font-weight: 800;
  font-size: 19px;

  margin-bottom: 14px;

  box-shadow:
    0 10px 25px rgba(37, 99, 235, 0.3);
}

.sidebar h2 {
  font-size: 15px;
  letter-spacing: 1.5px;

  color: #e2e8f0;

  margin-bottom: 25px;
}

.sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sidebar-link {
  width: 100%;

  border: none;

  background: transparent;

  color: #cbd5e1;

  text-align: left;

  padding: 13px 14px;

  border-radius: 9px;

  cursor: pointer;

  font-size: 14px;
  font-weight: 500;

  transition: 0.2s;
}

.sidebar-link:hover {
  background: rgba(255, 255, 255, 0.08);
  color: white;
}

.sidebar-link.active {
  background:
    linear-gradient(
      90deg,
      #2563eb,
      #1d4ed8
    );

  color: white;

  font-weight: 700;

  box-shadow:
    0 7px 18px rgba(37, 99, 235, 0.25);
}

.logout-button {
  margin-top: auto;

  width: 100%;

  border: none;

  background: rgba(239, 68, 68, 0.12);

  color: #fca5a5;

  padding: 13px;

  border-radius: 9px;

  cursor: pointer;

  font-size: 14px;
  font-weight: 600;
}

.logout-button:hover {
  background: #dc2626;
  color: white;
}

/* =========================
   MAIN CONTENT
========================= */

.main-content {
  flex: 1;

  min-width: 0;

  padding: 32px 38px;

  overflow-x: auto;
}

/* HEADER */

.page-header {
  margin-bottom: 28px;
}

.page-header h1 {
  font-size: 30px;
  color: #0f172a;
  margin-bottom: 7px;
}

.page-header p {
  color: #64748b;
  font-size: 14px;
}

/* =========================
   DASHBOARD CARDS
========================= */

.dashboard-cards {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 20px;

  margin-bottom: 28px;
}

.dashboard-card {
  background: white;

  padding: 23px;

  border-radius: 14px;

  border: 1px solid #e2e8f0;

  box-shadow:
    0 4px 15px rgba(15, 23, 42, 0.05);

  position: relative;

  overflow: hidden;
}

.dashboard-card::after {
  content: "";

  position: absolute;

  right: -25px;
  top: -25px;

  width: 80px;
  height: 80px;

  border-radius: 50%;

  background:
    rgba(37, 99, 235, 0.08);
}

.dashboard-card h3 {
  color: #64748b;

  font-size: 13px;

  font-weight: 600;

  margin-bottom: 12px;
}

.dashboard-card strong {
  display: block;

  color: #0f172a;

  font-size: 30px;
}

/* =========================
   CONTENT CARD
========================= */

.content-card {
  background: white;

  border: 1px solid #e2e8f0;

  border-radius: 14px;

  padding: 25px;

  margin-bottom: 25px;

  box-shadow:
    0 4px 15px rgba(15, 23, 42, 0.05);

  overflow-x: auto;
}

.content-card h2 {
  color: #0f172a;

  font-size: 19px;

  margin-bottom: 20px;
}

.section-title-row {
  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 15px;

  margin-bottom: 20px;
}

/* =========================
   TABLES
========================= */

table {
  width: 100%;

  min-width: 650px;

  border-collapse: collapse;
}

th {
  background: #f8fafc;

  color: #64748b;

  font-size: 12px;

  text-transform: uppercase;

  letter-spacing: 0.4px;

  font-weight: 700;

  padding: 14px;

  text-align: left;

  border-bottom: 1px solid #e2e8f0;
}

td {
  padding: 15px 14px;

  color: #334155;

  font-size: 14px;

  border-bottom: 1px solid #f1f5f9;
}

tbody tr:hover {
  background: #f8fafc;
}

/* =========================
   BUTTONS
========================= */

.primary-button {
  background:
    linear-gradient(
      135deg,
      #2563eb,
      #1d4ed8
    );

  color: white;

  border: none;

  padding: 11px 17px;

  border-radius: 8px;

  cursor: pointer;

  font-weight: 600;
}

.primary-button:hover {
  background: #1d4ed8;
}

.view-button {
  background: #eff6ff;

  color: #2563eb;

  border: 1px solid #bfdbfe;

  padding: 8px 13px;

  border-radius: 7px;

  cursor: pointer;

  font-weight: 600;

  font-size: 13px;
}

.view-button:hover {
  background: #dbeafe;
}

.back-button {
  border: none;

  background: #eff6ff;

  color: #2563eb;

  padding: 10px 15px;

  border-radius: 8px;

  cursor: pointer;

  margin-bottom: 25px;

  font-weight: 600;
}

/* =========================
   EMPLOYEE LINKS
========================= */

.employee-link {
  border: none;

  background: transparent;

  color: #2563eb;

  font-size: inherit;

  cursor: pointer;

  font-weight: 600;

  padding: 0;
}

.employee-link:hover {
  text-decoration: underline;
}

/* =========================
   STATUS
========================= */

.status-active {
  display: inline-block;

  background: #dcfce7;

  color: #15803d;

  padding: 5px 11px;

  border-radius: 20px;

  font-size: 12px;

  font-weight: 700;
}

/* =========================
   EMPLOYEE PROFILE
========================= */

.employee-profile-header {
  display: flex;

  align-items: center;

  gap: 20px;

  margin-bottom: 30px;
}

.employee-avatar {
  width: 78px;
  height: 78px;

  flex-shrink: 0;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #7c3aed
    );

  color: white;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 29px;

  font-weight: 800;
}

.employee-profile-header h2 {
  margin-bottom: 5px;
}

.employee-profile-header p {
  margin-bottom: 10px;

  color: #64748b;
}

/* =========================
   DETAILS
========================= */

.details-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 16px;
}

.detail-box {
  background: #f8fafc;

  border: 1px solid #e2e8f0;

  padding: 18px;

  border-radius: 10px;
}

.detail-box span {
  display: block;

  color: #64748b;

  font-size: 12px;

  margin-bottom: 7px;

  font-weight: 600;
}

.detail-box strong {
  color: #0f172a;

  font-size: 15px;
}

/* =========================
   DEPARTMENTS
========================= */

.department-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 20px;
}

.department-card {
  background: white;

  border: 1px solid #e2e8f0;

  border-radius: 14px;

  padding: 23px;

  box-shadow:
    0 4px 15px rgba(15, 23, 42, 0.05);

  transition: 0.2s;
}

.department-card:hover {
  transform: translateY(-3px);

  box-shadow:
    0 10px 25px rgba(15, 23, 42, 0.1);
}

.department-icon {
  width: 50px;
  height: 50px;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #7c3aed
    );

  color: white;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 20px;

  font-weight: 800;
}

.department-card h2 {
  margin: 17px 0 10px;

  font-size: 19px;
}

.department-card p {
  color: #64748b;

  margin-bottom: 8px;

  font-size: 14px;
}

/* =========================
   COMPANY INFORMATION
========================= */

.company-info {
  max-width: 1000px;
}

.company-info-logo {
  width: 85px;
  height: 85px;

  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #1d4ed8
    );

  color: white;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 28px;

  font-weight: 800;

  margin-bottom: 20px;
}

.company-info > p {
  color: #64748b;

  max-width: 700px;

  line-height: 1.7;

  margin-bottom: 28px;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 1100px) {
  .dashboard-cards {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .department-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 800px) {
  .login-image {
    display: none;
  }

  .
